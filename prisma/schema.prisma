generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LedgerType {
  EARN
  SPEND
  TRANSFER
  DAILY
  HUNT
  SELL
  GAMBLING
  ADMIN_GRANT
}

model User {
  id           String    @id @default(cuid())
  discordId    String    @unique
  cowoncy      BigInt    @default(0)
  dailyClaimAt DateTime?
  dailyStreak  Int       @default(0)    // <-- NEW FIELD ADDED
  lootboxes    Int       @default(0)    // <-- NEW FIELD ADDED
  huntPity     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inventory    Inventory?
  ledger       Ledger[]
}

model Inventory {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  items     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ledger {
  id            String     @id @default(cuid())
  user          User       @relation(fields: [userId], references: [id])
  userId        String
  amount        BigInt
  reason        String
  type          LedgerType
  balanceBefore BigInt
  balanceAfter  BigInt
  createdAt     DateTime   @default(now())
}

model LotteryRound {
  id              String          @id @default(cuid())
  pool            BigInt          @default(0)
  closesAt        DateTime
  drawnAt         DateTime?
  winnerDiscordId String?
  createdAt       DateTime        @default(now())
  tickets         LotteryTicket[]

  @@index([drawnAt, closesAt])
}

model LotteryTicket {
  id        String        @id @default(cuid())
  round     LotteryRound  @relation(fields: [roundId], references: [id])
  roundId   String
  discordId String
  tickets   Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([roundId, discordId])
  @@index([roundId])
}