{
  "name": "owo-claude-bot",
  "version": "1.0.0",
  "description": "OwO-style Discord bot with Prisma and PostgreSQL",
  "main": "dist/index.js",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node scripts/railway-start.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
